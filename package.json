{
  "name": "gouters-de-cecile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Design system du carnet « Les goûters de Cécile » (TV 1920×1080 et A5).",
  "scripts": {
    "dev": "npm run gen && vite",
    "tokens": "node scripts/build-tokens.mjs --report",
    "gen": "node scripts/gen-svg.mjs && node scripts/gen-entry.mjs",
    "typecheck": "node scripts/gen-entry.mjs && tsc --noEmit",
    "bundle": "node scripts/gen-entry.mjs && node scripts/build-bundle.mjs",
    "build": "node scripts/build-tokens.mjs && npm run gen && tsc --noEmit && node scripts/build-bundle.mjs && vite build",
    "shot": "node scripts/shot.mjs",
    "metrics": "node scripts/font-metrics.mjs",
    "textures": "node scripts/bake-textures.mjs",
    "artifact": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "opentype.js": "2.0.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "svgo": "4.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
